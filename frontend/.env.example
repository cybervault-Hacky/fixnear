# Copy to frontend/.env.local for local Next.js development.
# Backend API URL is server-only. In production it must use HTTPS.
FIXNEAR_API_BASE_URL=http://localhost:8000

# Exact browser origin used by the existing auth/logout BFF Origin check.
FRONTEND_URL=http://localhost:3000

# Optional server-only Supabase session validation settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
