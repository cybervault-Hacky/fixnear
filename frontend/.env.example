# Copy to frontend/.env.local for local Next.js development.
# Backend API URL is server-only. In production it must use HTTPS.
FIXNEAR_API_BASE_URL=http://localhost:8000

# Exact browser origin used by the existing auth/logout BFF Origin check.
FRONTEND_URL=http://localhost:3000

# Required in production (including production builds): exact public authorities,
# comma-separated. Include a port for non-default ports. No wildcard entries.
# Example: FIXNEAR_ALLOWED_HOSTS=fixnear.example,fixnear.example:8443
FIXNEAR_ALLOWED_HOSTS=
# Only enable behind a private proxy that overwrites (never appends) forwarded host
# and protocol headers and blocks direct access to Next.js. Next cannot verify peers.
FIXNEAR_TRUST_PROXY_HEADERS=false

# Server-only Supabase Auth settings. For password recovery, configure Supabase
# signup and recovery emails to display {{ .Token }} as a 6–8 digit code.
# Require email confirmation; link callbacks are not implemented.
# Do not log request bodies containing credentials or codes.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional PUBLIC MapTiler browser key, restricted by provider to your exact allowed domains.
# Disabled when empty. Enabling maps sends the tile provider the viewport and visitor IP
# only after explicit consent. Do not use a server secret here.
NEXT_PUBLIC_MAPTILER_KEY=
