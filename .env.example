# Copy this file to .env at the repository root for local development.
# Keep real credentials out of Git. Never put database credentials or a
# Supabase service-role key in frontend code or any NEXT_PUBLIC_ variable.

APP_ENV=development
DATABASE_URL=
ALEMBIC_DATABASE_URL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Server-only Next.js proxy target. Also set this in frontend/.env.local for Next.js.
FIXNEAR_API_BASE_URL=http://localhost:8000

# Server-only Next.js auth BFF settings; never prefix these with NEXT_PUBLIC_.
# FRONTEND_URL above is the exact trusted Origin for state-changing auth routes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=30
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

# Optional local API settings. CORS_ORIGINS must be a JSON array.
# The API only allows the exact origins listed here; credentials stay disabled.
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Development uses process-local memory by default. Production requires enabled
# limiting and RATE_LIMIT_REDIS_URL; startup checks configuration and pings Redis.
# Requests fail closed with 503 if the store later fails. Redis credentials belong
# in deployment secrets, never in this file. Configure ONLY trusted proxy IPs/CIDRs;
# forwarding chains are traversed right-to-left. Set Uvicorn --no-proxy-headers so
# ASGI peer addresses remain actual network peers. Do not trust public CIDRs.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_TRUSTED_PROXIES=[]
RATE_LIMIT_NETWORK_LIMIT=300
RATE_LIMIT_NETWORK_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_OVERVIEW_LIMIT=30
RATE_LIMIT_ADMIN_OVERVIEW_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_AUDIT_LIMIT=60
RATE_LIMIT_ADMIN_AUDIT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_SEARCH_LIMIT=60
RATE_LIMIT_ADMIN_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_REVIEW_SUBMIT_LIMIT=20
RATE_LIMIT_REVIEW_SUBMIT_WINDOW_SECONDS=60
RATE_LIMIT_TICKET_CREATE_LIMIT=20
RATE_LIMIT_TICKET_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_TICKET_REPLY_LIMIT=60
RATE_LIMIT_TICKET_REPLY_WINDOW_SECONDS=60

# No map-provider settings are consumed yet. Discovery uses a non-live schematic map.
# Before enabling tiles, select a provider, add its adapter and restricted public key,
# configure style/tile URLs, and provide required attribution/privacy disclosures.

# Notifications: no external delivery credentials or provider configuration exist.
# The optional manual local simulation worker uses the existing DATABASE_URL only.
# It does not send email, SMS, web push, or mobile push.
